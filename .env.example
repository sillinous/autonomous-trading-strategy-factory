# ATSF user-testing configuration
# Generate a strong random value before any network exposure.
ATSF_API_KEY=

# External market/news provider (optional; Stooq market history works without a key).
ALPHAVANTAGE_API_KEY=

# SEC requires an identifying User-Agent containing contact information.
ATSF_SEC_USER_AGENT=ATSF/0.1 contact@example.com

# Persistent research registry.
ATSF_REGISTRY_PATH=/data/atsf.sqlite3
